#!/usr/bin/python3
"""noVNC web client, VNC WebSocket bridge and window list, on one port.

    wine-webapp-gateway LISTEN_PORT VNC_PORT WEB_DIR

websockify (as a library) serves WEB_DIR and bridges WebSocket connections to
the VNC server on localhost:VNC_PORT, as the plain `websockify` command does.
It adds the window list (docs/frontends.md, "Window list"):

    GET  /api/windows              top-level windows a user can switch to, top first
    POST /api/windows/HWND/raise   bring one to the front

and fits the Wine desktop to the browser window (docs/frontends.md, "Screen
size"):

    POST /api/screen               {"width": W, "height": H}, after noVNC resized Xvnc

All run winlist.exe once per request; nothing polls, and no Wine process stays
running beside the app (wine-webapp-run waits for wineserver to exit to notice
that the app has quit). Runs as user webapp, with DISPLAY and WINEPREFIX set.

And what lets a browser install the page as an app (docs/frontends.md,
"Installed as an app"):

    GET  /manifest.webmanifest     web app manifest: name, icons, standalone window
    GET  /icons/icon-N.png         the app image's icons (/etc/wine-webapp/icons)
    GET  /api/info                 app name, screen size and resize mode, for the page
"""
import json
import logging
import os
import re
import subprocess
import sys
from urllib.parse import urlsplit

from websockify.websocketproxy import ProxyRequestHandler, WebSocketProxy

WINLIST = ["wine", "/usr/local/lib/wine-webapp/winlist.exe"]
RAISE = re.compile(r"^/api/windows/([0-9a-f]{1,16})/raise$")
FIELDS = ("hwnd", "owner", "pid", "flags", "x", "y", "width", "height", "class", "title")
ICON_DIR = "/etc/wine-webapp/icons"
ICON = re.compile(r"^/icons/(icon-([0-9]{1,4})\.png)$")


def size(var):
    """An environment variable WxH as (W, H)."""
    w, h = os.environ[var].lower().split("x")
    return int(w), int(h)


def app_name():
    """WEBAPP_NAME, or the program's file name without its extension."""
    name = os.environ.get("WEBAPP_NAME", "").strip()
    if name:
        return name
    exe = os.environ.get("APP_EXE", "").replace("\\", "/").rsplit("/", 1)[-1]
    return exe.rsplit(".", 1)[0] or "Application"


def icons():
    """icon-N.png files in ICON_DIR as manifest entries, smallest first."""
    try:
        files = os.listdir(ICON_DIR)
    except OSError:
        return []
    found = sorted((int(m.group(2)), m.group(1)) for m in
                   (ICON.match("/icons/" + f) for f in files) if m)
    return [{"src": "icons/" + f, "sizes": "%dx%d" % (n, n), "type": "image/png"} for n, f in found]


def manifest():
    background = os.environ.get("WEBAPP_BACKGROUND", "#333333")
    return {
        "name": app_name(),
        "short_name": app_name(),
        # Relative to the manifest, so the app works under a reverse proxy's
        # path prefix too.
        "id": "./",
        "start_url": "./",
        "scope": "./",
        "display": "standalone",
        "background_color": background,
        "theme_color": background,
        "icons": icons(),
        # One window per app: launching it again focuses the open one.
        "launch_handler": {"client_mode": "focus-existing"},
    }


def winlist(*args):
    """Run winlist.exe; return its stdout, or raise RuntimeError."""
    try:
        r = subprocess.run(WINLIST + list(args), capture_output=True, timeout=20,
                           text=True, encoding="cp1252", errors="replace")
    except subprocess.TimeoutExpired:
        raise RuntimeError("winlist timed out")
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "winlist exited with %d" % r.returncode)
    return r.stdout


def windows():
    """Visible, titled, non-tool top-level windows, top of the z-order first."""
    result = []
    for line in winlist("-t").splitlines():
        parts = line.split("\t")
        if len(parts) != len(FIELDS):
            continue
        w = dict(zip(FIELDS, parts))
        flags = w.pop("flags")
        if "V" not in flags or "T" in flags or not w["title"].strip():
            continue
        result.append({
            "hwnd": w["hwnd"],
            "owner": None if int(w["owner"], 16) == 0 else w["owner"],
            "pid": int(w["pid"]),
            "title": w["title"],
            "class": w["class"],
            "enabled": "E" in flags,
            "minimized": "I" in flags,
            "maximized": "Z" in flags,
            "rect": [int(w[k]) for k in ("x", "y", "width", "height")],
        })
    return result


class Handler(ProxyRequestHandler):
    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/api/windows":
            try:
                self.reply(200, {"windows": windows()})
            except RuntimeError as e:
                self.reply(503, {"error": str(e)})
            return
        if path == "/api/info":
            self.reply(200, {
                "name": app_name(),
                "screen": os.environ.get("WEBAPP_SCREEN", ""),
                "resize": os.environ.get("WEBAPP_RESIZE", "scale"),
                "min": os.environ.get("WEBAPP_SCREEN_MIN", ""),
                "max": os.environ.get("WEBAPP_SCREEN_MAX", ""),
            })
            return
        if path == "/manifest.webmanifest":
            self.reply(200, manifest(), "application/manifest+json")
            return
        m = ICON.match(path)
        if m:
            try:
                with open(os.path.join(ICON_DIR, m.group(1)), "rb") as f:
                    self.send_file(f.read(), "image/png")
            except OSError:
                self.reply(404, {"error": "not found"})
            return
        super().do_GET()

    def do_POST(self):
        path = urlsplit(self.path).path
        m = RAISE.match(path)
        if not m and path != "/api/screen":
            self.reply(404, {"error": "not found"})
            return
        # A page from another site must not drive the app: browsers send
        # Origin on cross-site POSTs. Access control itself is the reverse
        # proxy's job (docs/frontends.md, "Contract for a front end"); a proxy
        # that rewrites Host passes the original in X-Forwarded-Host.
        origin = self.headers.get("Origin")
        hosts = {self.headers.get("Host"), self.headers.get("X-Forwarded-Host")}
        if origin and urlsplit(origin).netloc not in hosts:
            self.reply(403, {"error": "cross-origin request"})
            return
        if m:
            try:
                winlist("raise", m.group(1))
                self.reply(200, {"raised": m.group(1)})
            except RuntimeError as e:
                self.reply(409, {"error": str(e)})
            return
        self.fit_screen()

    def fit_screen(self):
        """POST /api/screen {"width": W, "height": H}: the browser has asked
        Xvnc for a WxH screen; fit the Wine desktop to it."""
        if os.environ.get("WEBAPP_RESIZE") != "remote":
            self.reply(409, {"error": "the screen size is fixed (WEBAPP_RESIZE=scale)"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            body = json.loads(self.rfile.read(min(length, 1024)) or b"{}")
            w, h = int(body["width"]), int(body["height"])
        except (ValueError, KeyError, TypeError):
            self.reply(400, {"error": "expected {\"width\": W, \"height\": H}"})
            return
        (min_w, min_h), (max_w, max_h) = size("WEBAPP_SCREEN_MIN"), size("WEBAPP_SCREEN_MAX")
        if not (min_w <= w <= max_w and min_h <= h <= max_h):
            self.reply(400, {"error": "size out of range"})
            return
        try:
            winlist("fit", str(w), str(h))
            self.reply(200, {"screen": "%dx%d" % (w, h)})
        except RuntimeError as e:
            self.reply(409, {"error": str(e)})

    def reply(self, status, body, content_type="application/json"):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_file(self, data, content_type):
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s")
    listen_port, vnc_port, web = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
    WebSocketProxy(RequestHandlerClass=Handler, listen_host="0.0.0.0", listen_port=listen_port,
                   target_host="localhost", target_port=vnc_port, web=web).start_server()


if __name__ == "__main__":
    main()
