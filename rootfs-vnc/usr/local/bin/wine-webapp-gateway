#!/usr/bin/python3
"""noVNC web client, VNC WebSocket bridge and window list, on one port.

    wine-webapp-gateway LISTEN_PORT VNC_PORT WEB_DIR

websockify (as a library) serves WEB_DIR and bridges WebSocket connections to
the VNC server on localhost:VNC_PORT, as the plain `websockify` command does.
It adds the window list (docs/frontends.md, "Window list"):

    GET  /api/windows              top-level windows a user can switch to, top first
    POST /api/windows/HWND/raise   bring one to the front

and fits the Wine desktop to the browser window (docs/frontends.md, "Screen
size"):

    POST /api/screen               {"width": W, "height": H}, after noVNC resized Xvnc

All run winlist.exe once per request; nothing polls, and no Wine process stays
running beside the app (wine-webapp-run waits for wineserver to exit to notice
that the app has quit). Runs as user webapp, with DISPLAY and WINEPREFIX set.

And what lets a browser install the page as an app (docs/frontends.md,
"Installed as an app"):

    GET  /manifest.webmanifest     web app manifest: name, icons, standalone window
    GET  /icons/icon-N.png         the app image's icons (/etc/wine-webapp/icons)
    GET  /api/info                 app name, colour, screen size and resize mode, for the page

A notice for the user, set by the session broker (docs/broker.md), e.g.
before an idle session is closed:
    GET  /api/notice               {"kind", "message", "deadline"} or {}
    GET  /api/login                {"state": "waiting|filling|ok|failed|mismatch"}, or {}
                                   without the broker's login watcher
And the app's prints, PDFs from the cups-pdf printer (docs/frontends.md,
"Printing"):

    GET  /api/prints               finished prints, newest first; older ones are deleted
    GET  /prints/NAME              one print, to view in the browser
"""
import json
import logging
import os
import re
import subprocess
import sys
import time
import zipfile
from xml.sax.saxutils import escape
from urllib.parse import quote, unquote, urlsplit

from websockify.websocketproxy import ProxyRequestHandler, WebSocketProxy

WINLIST = ["wine", "/usr/local/lib/wine-webapp/winlist.exe"]
RAISE = re.compile(r"^/api/windows/([0-9a-f]{1,16})/raise$")
FIELDS = ("hwnd", "owner", "pid", "flags", "x", "y", "width", "height", "class", "title")
ICON_DIR = "/etc/wine-webapp/icons"
ICON = re.compile(r"^/icons/(icon-([0-9]{1,4})\.png)$")
PRINT_DIR = os.path.expanduser("~/PDF")  # cups-pdf's Out ${HOME}/PDF, as user webapp
PRINT = re.compile(r"^/prints/([^/]+\.(?:pdf|xlsx))$")
PRINT_JOB = re.compile(r"-(?:job|xlsx)_([0-9]+)\.(?:pdf|xlsx)$")
# The Excel stand-in's staging files: %USERPROFILE%\.exports inside the prefix.
EXPORT_DIR = os.path.join(os.environ.get("WINEPREFIX", os.path.expanduser("~/.wine")),
                          "drive_c", "users", os.environ.get("USER", "webapp"), ".exports")
XLSX = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"


def _unescape(s):
    return re.sub(r"\\(.)", lambda m: {"t": "\t", "n": "\n", "r": "\r"}.get(m.group(1), m.group(1)), s)


def _col(n):
    out = ""
    while n:
        n, r = divmod(n - 1, 26)
        out = chr(65 + r) + out
    return out


_XML_BAD = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f]")


def write_xlsx(cells, path):
    """A one-sheet .xlsx from [(row, col, type, format, value)]: numbers as
    numbers with their number formats, text as inline strings, columns
    roughly as wide as their contents."""
    formats = {}
    for _, _, _, fmt, _ in cells:
        if fmt and fmt != "General" and fmt not in formats:
            formats[fmt] = len(formats)
    widths, rows = {}, {}
    for r, c, t, fmt, v in cells:
        rows.setdefault(r, []).append((c, t, fmt, v))
        widths[c] = max(widths.get(c, 0), min(60, max(len(x) for x in v.split("\n")) + 2))
    sheet = ['<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
             '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><cols>']
    for c in sorted(widths):
        sheet.append(f'<col min="{c}" max="{c}" width="{max(widths[c], 8)}" customWidth="1"/>')
    sheet.append("</cols><sheetData>")
    for r in sorted(rows):
        sheet.append(f'<row r="{r}">')
        for c, t, fmt, v in sorted(rows[r]):
            ref = f"{_col(c)}{r}"
            style = f' s="{formats[fmt] + 1}"' if fmt in formats else ""
            if t == "n":
                try:
                    float(v)
                    sheet.append(f'<c r="{ref}"{style}><v>{v}</v></c>')
                    continue
                except ValueError:
                    pass
            if t == "b":
                sheet.append(f'<c r="{ref}" t="b"><v>{1 if v.lower() in ("true", "-1", "1") else 0}</v></c>')
                continue
            text = escape(_XML_BAD.sub("", v))
            sheet.append(f'<c r="{ref}" t="inlineStr"{style}><is><t xml:space="preserve">{text}</t></is></c>')
        sheet.append("</row>")
    sheet.append("</sheetData></worksheet>")
    numfmts = "".join(f'<numFmt numFmtId="{164 + i}" formatCode="{escape(f, {chr(34): "&quot;"})}"/>'
                      for f, i in formats.items())
    xfs = "".join(f'<xf numFmtId="{164 + i}" fontId="0" fillId="0" borderId="0" xfId="0" applyNumberFormat="1"/>'
                  for i in formats.values())
    styles = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
              '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
              f'<numFmts count="{len(formats)}">{numfmts}</numFmts>'
              '<fonts count="1"><font><sz val="11"/><name val="Calibri"/></font></fonts>'
              '<fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills>'
              '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'
              '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'
              f'<cellXfs count="{len(formats) + 1}"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>{xfs}</cellXfs>'
              '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>'
              '</styleSheet>')
    parts = {
        "[Content_Types].xml": '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
            '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
            '<Default Extension="xml" ContentType="application/xml"/>'
            '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
            '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
            '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>'
            '</Types>',
        "_rels/.rels": '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>'
            '</Relationships>',
        "xl/workbook.xml": '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
            'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
            '<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>',
        "xl/_rels/workbook.xml.rels": '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>'
            '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>'
            '</Relationships>',
        "xl/worksheets/sheet1.xml": "".join(sheet),
        "xl/styles.xml": styles,
    }
    tmp = path + ".part"
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
        for name, data in parts.items():
            z.writestr(name, data)
    os.replace(tmp, path)


def convert_exports():
    """Turn the Excel stand-in's staging files into .xlsx files among the
    prints, named after the sheet's first text (usually the report title)."""
    try:
        names = sorted(n for n in os.listdir(EXPORT_DIR) if n.endswith(".cells"))
    except OSError:
        return
    for name in names:
        src = os.path.join(EXPORT_DIR, name)
        cells = []
        try:
            with open(src, encoding="utf-8", errors="replace") as f:
                for line in f:
                    r, c, t, fmt, v = line.rstrip("\n").split("\t", 4)
                    cells.append((int(r), int(c), t, _unescape(fmt), _unescape(v)))
        except (OSError, ValueError) as e:
            logging.warning("cannot read %s: %s", src, e)
            os.replace(src, src + ".bad")
            continue
        texts = [v for _, _, t, _, v in sorted(cells) if t == "s" and v.strip()]
        title = re.sub(r"[^A-Za-z0-9 ._-]+", "", texts[0] if texts else "Spreadsheet").strip()[:60] or "Spreadsheet"
        os.makedirs(PRINT_DIR, exist_ok=True)
        dest = os.path.join(PRINT_DIR, f"{title.replace(' ', '_')}-xlsx_{int(time.time() * 1000) % 10**9}.xlsx")
        try:
            write_xlsx(cells, dest)
            os.remove(src)
        except OSError as e:
            logging.warning("cannot write %s: %s", dest, e)


def prints():
    """Finished prints, newest first. cups-pdf names them TITLE-job_N.pdf
    (spaces as underscores). A file still changing is left out; one older
    than WEBAPP_PRINTS_KEEP_HOURS is deleted."""
    keep = float(os.environ.get("WEBAPP_PRINTS_KEEP_HOURS", "24")) * 3600
    convert_exports()
    now = time.time()
    result = []
    try:
        names = os.listdir(PRINT_DIR)
    except OSError:
        return []
    for name in names:
        if not name.endswith((".pdf", ".xlsx")):
            continue
        path = os.path.join(PRINT_DIR, name)
        try:
            st = os.stat(path)
        except OSError:
            continue
        if now - st.st_mtime > keep:
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        if now - st.st_mtime < 2:  # cups-pdf may still be writing it
            continue
        m = PRINT_JOB.search(name)
        kind = "xlsx" if name.endswith(".xlsx") else "pdf"
        title = (name[:m.start()] if m else name.rsplit(".", 1)[0]).replace("_", " ").strip() or "Print"
        result.append({"name": name, "url": "prints/" + quote(name), "title": title, "kind": kind,
                       "job": int(m.group(1)) if m else 0, "time": int(st.st_mtime),
                       "size": st.st_size})
    result.sort(key=lambda p: (p["time"], p["job"]), reverse=True)
    return result


def size(var):
    """An environment variable WxH as (W, H)."""
    w, h = os.environ[var].lower().split("x")
    return int(w), int(h)


def app_name():
    """WEBAPP_NAME, or the program's file name without its extension."""
    name = os.environ.get("WEBAPP_NAME", "").strip()
    if name:
        return name
    exe = os.environ.get("APP_EXE", "").replace("\\", "/").rsplit("/", 1)[-1]
    return exe.rsplit(".", 1)[0] or "Application"


def icons():
    """icon-N.png files in ICON_DIR as manifest entries, smallest first."""
    try:
        files = os.listdir(ICON_DIR)
    except OSError:
        return []
    found = sorted((int(m.group(2)), m.group(1)) for m in
                   (ICON.match("/icons/" + f) for f in files) if m)
    return [{"src": "icons/" + f, "sizes": "%dx%d" % (n, n), "type": "image/png"} for n, f in found]


def manifest():
    background = os.environ.get("WEBAPP_BACKGROUND", "#333333")
    return {
        "name": app_name(),
        "short_name": app_name(),
        # Relative to the manifest, so the app works under a reverse proxy's
        # path prefix too.
        "id": "./",
        "start_url": "./",
        "scope": "./",
        "display": "standalone",
        "background_color": background,
        "theme_color": background,
        "icons": icons(),
        # One window per app: launching it again focuses the open one.
        "launch_handler": {"client_mode": "focus-existing"},
    }


def winlist(*args):
    """Run winlist.exe; return its stdout, or raise RuntimeError."""
    try:
        r = subprocess.run(WINLIST + list(args), capture_output=True, timeout=20,
                           text=True, encoding="cp1252", errors="replace")
    except subprocess.TimeoutExpired:
        raise RuntimeError("winlist timed out")
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "winlist exited with %d" % r.returncode)
    return r.stdout


def windows():
    """Visible, titled, non-tool top-level windows, top of the z-order first."""
    result = []
    for line in winlist("-t").splitlines():
        parts = line.split("\t")
        if len(parts) != len(FIELDS):
            continue
        w = dict(zip(FIELDS, parts))
        flags = w.pop("flags")
        if "V" not in flags or "T" in flags or not w["title"].strip():
            continue
        result.append({
            "hwnd": w["hwnd"],
            "owner": None if int(w["owner"], 16) == 0 else w["owner"],
            "pid": int(w["pid"]),
            "title": w["title"],
            "class": w["class"],
            "enabled": "E" in flags,
            "minimized": "I" in flags,
            "maximized": "Z" in flags,
            "rect": [int(w[k]) for k in ("x", "y", "width", "height")],
        })
    return result


class Handler(ProxyRequestHandler):
    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/api/windows":
            try:
                self.reply(200, {"windows": windows()})
            except RuntimeError as e:
                self.reply(503, {"error": str(e)})
            return
        if path == "/api/info":
            self.reply(200, {
                "name": app_name(),
                "screen": os.environ.get("WEBAPP_SCREEN", ""),
                "resize": os.environ.get("WEBAPP_RESIZE", "scale"),
                "min": os.environ.get("WEBAPP_SCREEN_MIN", ""),
                "max": os.environ.get("WEBAPP_SCREEN_MAX", ""),
                "background": os.environ.get("WEBAPP_BACKGROUND", "#333333"),
            })
            return
        if path == "/manifest.webmanifest":
            self.reply(200, manifest(), "application/manifest+json")
            return
        m = ICON.match(path)
        if m:
            try:
                with open(os.path.join(ICON_DIR, m.group(1)), "rb") as f:
                    self.send_file(f.read(), "image/png")
            except OSError:
                self.reply(404, {"error": "not found"})
            return
        if path == "/api/login":
            try:
                with open("/run/wine-webapp/login.state") as f:
                    self.reply(200, {"state": f.read().strip()})
            except OSError:
                self.reply(200, {})
            return
        if path == "/api/notice":
            try:
                with open("/run/wine-webapp/notice.json") as f:
                    self.reply(200, json.load(f))
            except (OSError, ValueError):
                self.reply(200, {})
            return
        if path == "/api/prints":
            self.reply(200, {"prints": prints()})
            return
        m = PRINT.match(path)
        if m:
            # only a name the listing shows, never a path
            name = unquote(m.group(1))
            if name not in {p["name"] for p in prints()}:
                self.reply(404, {"error": "not found"})
                return
            try:
                with open(os.path.join(PRINT_DIR, name), "rb") as f:
                    sheet = name.endswith(".xlsx")
                    self.send_file(f.read(), XLSX if sheet else "application/pdf",
                                   {"Content-Disposition": ("attachment" if sheet else "inline")
                                    + "; filename*=UTF-8''" + quote(name),
                                    "Cache-Control": "no-store"})
            except OSError:
                self.reply(404, {"error": "not found"})
            return
        super().do_GET()

    def do_POST(self):
        path = urlsplit(self.path).path
        m = RAISE.match(path)
        if not m and path != "/api/screen":
            self.reply(404, {"error": "not found"})
            return
        # A page from another site must not drive the app: browsers send
        # Origin on cross-site POSTs. Access control itself is the reverse
        # proxy's job (docs/frontends.md, "Contract for a front end"); a proxy
        # that rewrites Host passes the original in X-Forwarded-Host.
        origin = self.headers.get("Origin")
        hosts = {self.headers.get("Host"), self.headers.get("X-Forwarded-Host")}
        if origin and urlsplit(origin).netloc not in hosts:
            self.reply(403, {"error": "cross-origin request"})
            return
        if m:
            try:
                winlist("raise", m.group(1))
                self.reply(200, {"raised": m.group(1)})
            except RuntimeError as e:
                self.reply(409, {"error": str(e)})
            return
        self.fit_screen()

    def fit_screen(self):
        """POST /api/screen {"width": W, "height": H}: the browser has asked
        Xvnc for a WxH screen; fit the Wine desktop to it."""
        if os.environ.get("WEBAPP_RESIZE") != "remote":
            self.reply(409, {"error": "the screen size is fixed (WEBAPP_RESIZE=scale)"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            body = json.loads(self.rfile.read(min(length, 1024)) or b"{}")
            w, h = int(body["width"]), int(body["height"])
        except (ValueError, KeyError, TypeError):
            self.reply(400, {"error": "expected {\"width\": W, \"height\": H}"})
            return
        (min_w, min_h), (max_w, max_h) = size("WEBAPP_SCREEN_MIN"), size("WEBAPP_SCREEN_MAX")
        if not (min_w <= w <= max_w and min_h <= h <= max_h):
            self.reply(400, {"error": "size out of range"})
            return
        try:
            winlist("fit", str(w), str(h))
            self.reply(200, {"screen": "%dx%d" % (w, h)})
        except RuntimeError as e:
            self.reply(409, {"error": str(e)})

    def end_headers(self):
        # The page itself is never cached: reopening an installed app's
        # window must load it afresh (and, behind the broker, start a
        # session), not bring back a page whose session has ended.
        if urlsplit(self.path).path in ("/", "/index.html"):
            self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def reply(self, status, body, content_type="application/json"):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_file(self, data, content_type, headers=None):
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s")
    listen_port, vnc_port, web = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
    WebSocketProxy(RequestHandlerClass=Handler, listen_host="0.0.0.0", listen_port=listen_port,
                   target_host="localhost", target_port=vnc_port, web=web).start_server()


if __name__ == "__main__":
    main()
